"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "my_custom_robot"
{
    over "Geometry"
    {
        over "chassis" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            point3f physics:centerOfMass = (0, 0, -0.05)
            float3 physics:diagonalInertia = (0.021, 0.035, 0.052)
            float physics:mass = 2.5
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "left_wheel" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                float3 physics:diagonalInertia = (0.00015, 0.00015, 0.00025)
                float physics:mass = 0.2
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "cylinder_1" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "right_wheel" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                float3 physics:diagonalInertia = (0.00015, 0.00015, 0.00025)
                float physics:mass = 0.2
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "cylinder_1" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "caster_wheel" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
                float physics:mass = 0.05
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "sphere_1" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "lidar_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                float3 physics:diagonalInertia = (0.00001, 0.00001, 0.00001)
                float physics:mass = 0.05
                quatf physics:principalAxes = (1, 0, 0, 0)
            }

            over "camera_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                float3 physics:diagonalInertia = (0.000001, 0.000001, 0.000001)
                float physics:mass = 0.02
                quatf physics:principalAxes = (1, 0, 0, 0)
            }

            over "box_1" (
                prepend apiSchemas = ["NewtonCollisionAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "left_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            prepend rel physics:body0 = </my_custom_robot/Geometry/chassis>
            custom rel physics:body1
            prepend rel physics:body1 = </my_custom_robot/Geometry/chassis/left_wheel>
            point3f physics:localPos0 = (-0.1, 0.175, -0.05)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "right_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            prepend rel physics:body0 = </my_custom_robot/Geometry/chassis>
            custom rel physics:body1
            prepend rel physics:body1 = </my_custom_robot/Geometry/chassis/right_wheel>
            point3f physics:localPos0 = (-0.1, -0.175, -0.05)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </my_custom_robot>
            custom rel physics:body1
            prepend rel physics:body1 = </my_custom_robot/Geometry/chassis>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "caster_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </my_custom_robot/Geometry/chassis>
            custom rel physics:body1
            prepend rel physics:body1 = </my_custom_robot/Geometry/chassis/caster_wheel>
            point3f physics:localPos0 = (0.15, 0, -0.075)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "lidar_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </my_custom_robot/Geometry/chassis>
            custom rel physics:body1
            prepend rel physics:body1 = </my_custom_robot/Geometry/chassis/lidar_link>
            point3f physics:localPos0 = (0, 0, 0.075)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "camera_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </my_custom_robot/Geometry/chassis>
            custom rel physics:body1
            prepend rel physics:body1 = </my_custom_robot/Geometry/chassis/camera_link>
            point3f physics:localPos0 = (0.21, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

