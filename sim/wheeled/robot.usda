    }

    def Cube "boundary_west" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        color3f[] primvars:displayColor = [(0.6, 0.6, 0.6)]
        double size = 1
        float3 xformOp:scale = (0.5, 20, 2)
        double3 xformOp:translate = (-10, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def DistantLight "SunLight"
    {
        float inputs:angle = 1
        float inputs:intensity = 3000
        float3 xformOp:rotateXYZ = (-30, 10, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "DomeLight"
    {
        float inputs:intensity = 400
    }
}

